---
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import androidLight from '../assets/screenshots/android-home-light.png';
import androidDark from '../assets/screenshots/android-home-dark.png';
import iosLight from '../assets/screenshots/ios-home-light.png';
import iosDark from '../assets/screenshots/ios-home-dark.png';
import macosLight from '../assets/screenshots/macos-home-light.png';
import macosDark from '../assets/screenshots/macos-home-dark.png';
import windowsLight from '../assets/screenshots/windows-home-light.png';
import windowsDark from '../assets/screenshots/windows-home-dark.png';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Deliberate desktop/mobile pairing per row: wide shots get the large
// column, phone shots a narrow one (capped to a phone-like width so they
// read as devices, not stretched banners). Rows alternate sides for rhythm.
// Each entry carries both theme variants; the toggle button switches them.
const shots = [
  { light: macosLight, dark: macosDark, label: t('screenshots.macos'), kind: 'desktop', side: 'left' },
  { light: androidLight, dark: androidDark, label: t('screenshots.android'), kind: 'mobile', side: 'right' },
  { light: iosLight, dark: iosDark, label: t('screenshots.ios'), kind: 'mobile', side: 'left' },
  { light: windowsLight, dark: windowsDark, label: t('screenshots.windows'), kind: 'desktop', side: 'right' },
];
---

<section id="screenshots" class="section shots-section" data-theme-shot="light">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Screenshots</p>
      <h2>{t('screenshots.title')}</h2>
      <p>{t('screenshots.subtitle')}</p>
      <div class="theme-toggle" role="group" aria-label={t('screenshots.toggle.aria')}>
        <button type="button" class="toggle-btn active" data-shot-theme="light">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
          {t('screenshots.light')}
        </button>
        <button type="button" class="toggle-btn" data-shot-theme="dark">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
          </svg>
          {t('screenshots.dark')}
        </button>
      </div>
    </div>
    <div class="grid">
      {
        shots.map((s, i) => (
          <figure
            class={`shot ${s.kind} ${s.side} reveal`}
            style={`--d:${i * 120}ms`}
          >
            <div class="frame">
              <Image
                src={s.light}
                alt={`Mediary — ${s.label} (${t('screenshots.light')})`}
                class="shot-light"
                widths={[400, 800, 1200]}
                sizes={s.kind === 'desktop' ? '(max-width: 900px) 92vw, 640px' : '(max-width: 900px) 70vw, 300px'}
                loading="lazy"
                decoding="async"
              />
              <Image
                src={s.dark}
                alt={`Mediary — ${s.label} (${t('screenshots.dark')})`}
                class="shot-dark"
                widths={[400, 800, 1200]}
                sizes={s.kind === 'desktop' ? '(max-width: 900px) 92vw, 640px' : '(max-width: 900px) 70vw, 300px'}
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption>{s.label}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .shots-section {
    background: var(--color-surface-sunken);
    border-block: 1px solid var(--color-hairline-soft);
  }

  /* Light/dark switch: pill group under the section heading. */
  .theme-toggle {
    display: inline-flex;
    margin-top: var(--space-3);
    padding: 3px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    background: var(--color-surface-raised);
    gap: 2px;
  }
  .toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text-secondary);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .toggle-btn:hover {
    color: var(--color-primary-strong);
  }
  .toggle-btn.active {
    background: var(--color-primary-soft);
    color: var(--color-primary-strong);
  }

  /* 12-column grid: each row pairs one wide desktop shot (7-8 cols) with
     one narrow phone shot (4-5 cols), alternating sides. */
  .grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--space-4) var(--space-3);
    align-items: center;
  }
  .shot {
    margin: 0;
    min-width: 0;
  }
  .shot.desktop.left {
    grid-column: 1 / span 8;
  }
  .shot.mobile.right {
    grid-column: 10 / span 3;
    justify-self: center;
  }
  .shot.mobile.left {
    grid-column: 1 / span 3;
    justify-self: center;
  }
  .shot.desktop.right {
    grid-column: 5 / span 8;
  }

  /* Phone shots are capped so they read as devices at a natural size. */
  .shot.mobile .frame {
    max-width: 300px;
    margin-inline: auto;
  }

  .frame {
    position: relative;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-hairline);
    overflow: hidden;
    background: var(--color-surface-raised);
    box-shadow: 0 8px 24px rgb(29 26 36 / 0.08);
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.3s ease;
  }
  .shot:hover .frame {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px color-mix(in srgb, var(--color-primary) 18%, transparent);
  }
  .frame img {
    width: 100%;
  }

  /* Both theme variants are stacked; the section-level data attribute
     decides which one is visible. The hidden one stays in the layout
     (visibility) so the frame never collapses while images load. */
  .frame .shot-dark {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .frame .shot-light {
    transition: opacity 0.35s ease;
  }
  [data-theme-shot="dark"] .frame .shot-dark {
    opacity: 1;
  }
  [data-theme-shot="dark"] .frame .shot-light {
    opacity: 0;
  }

  .shot figcaption {
    margin-top: var(--space-1);
    text-align: center;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  /* Entrance: fade + rise + slight scale, staggered via --d. Uses a
     keyframe animation (not a transition) so it plays from its first frame
     even when the section is already in view on load — e.g. after the
     browser restores scroll position on refresh, a transition would have no
     starting frame and would silently skip. Hidden state is JS-gated
     (html.js) so no-JS users and crawlers always see the shots. */
  @keyframes shot-in {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  :global(html.js) .reveal:not(.in) {
    opacity: 0;
  }
  :global(html.js) .reveal.in {
    animation: shot-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms) both;
  }

  /* Tablet: two per row, desktop shots full width of their half. */
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3);
      align-items: start;
    }
    .shot.desktop.left,
    .shot.desktop.right,
    .shot.mobile.left,
    .shot.mobile.right {
      grid-column: auto;
      justify-self: stretch;
    }
    .shot.mobile .frame {
      max-width: 260px;
    }
  }

  /* Phone: single column; mobile shots stay device-sized and centered. */
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .shot.mobile .frame {
      max-width: 240px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .reveal:not(.in) {
      opacity: 1;
    }
    :global(html.js) .reveal.in {
      animation: none;
    }
    .frame {
      transition: none;
    }
    .shot:hover .frame {
      transform: none;
    }
    .frame .shot-dark,
    .frame .shot-light {
      transition: none;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('#screenshots');
  const buttons = document.querySelectorAll<HTMLButtonElement>('#screenshots .toggle-btn');
  for (const btn of buttons) {
    btn.addEventListener('click', () => {
      const theme = btn.dataset.shotTheme ?? 'light';
      section?.setAttribute('data-theme-shot', theme);
      for (const b of buttons) {
        b.classList.toggle('active', b === btn);
        b.setAttribute('aria-pressed', String(b === btn));
      }
    });
  }

  const shots = document.querySelectorAll<HTMLElement>('#screenshots .reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.2, rootMargin: '0px 0px -60px 0px' },
    );
    shots.forEach((el) => io.observe(el));
  } else {
    shots.forEach((el) => el.classList.add('in'));
  }
</script>
