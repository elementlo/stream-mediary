---
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import { releases, type ChangeKind } from '../i18n/changelog';
import { GITHUB_REPO } from '../i18n/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const entries = releases[lang];
const changelogUrl = `${GITHUB_REPO}/blob/main/CHANGELOG.md`;

const kindMeta: Record<ChangeKind, { label: string; cls: string }> = {
  added: { label: t('whatsnew.added'), cls: 'k-added' },
  changed: { label: t('whatsnew.changed'), cls: 'k-changed' },
  fixed: { label: t('whatsnew.fixed'), cls: 'k-fixed' },
};
---

<section id="whatsnew" class="section wn-section">
  <div class="container narrow">
    <div class="section-head">
      <p class="eyebrow">Changelog</p>
      <h2>{t('whatsnew.title')}</h2>
      <p>{t('whatsnew.subtitle')}</p>
    </div>

    <ol class="timeline">
      {
        entries.map((rel, i) => (
          <li class="release reveal" style={`--d:${i * 90}ms`}>
            <div class="marker" aria-hidden="true" />
            <div class="card">
              <div class="rel-head">
                <h3>
                  v{rel.version}
                  {i === 0 && <span class="latest">{lang === 'en' ? 'Latest' : '最新'}</span>}
                </h3>
                <time datetime={rel.date}>{rel.date}</time>
              </div>
              <ul class="changes">
                {rel.changes.map((c) => (
                  <li>
                    <span class={`tag ${kindMeta[c.kind].cls}`}>
                      {kindMeta[c.kind].label}
                    </span>
                    <span class="text">{c.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="cta-center">
      <a class="btn btn-outline" href={changelogUrl} rel="noopener">
        {t('whatsnew.full')}
      </a>
    </div>
  </div>
</section>

<style>
  .wn-section {
    background: var(--color-surface);
  }
  .narrow {
    max-width: 760px;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  /* Hairline spine the release markers sit on. */
  .timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--color-hairline);
    border-radius: 1px;
  }

  .release {
    position: relative;
    padding-left: var(--space-4);
    padding-bottom: var(--space-3);
  }
  .release:last-child {
    padding-bottom: 0;
  }
  .marker {
    position: absolute;
    left: 0;
    top: 6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 3px solid var(--color-primary);
  }
  .release:first-child .marker {
    background: var(--color-primary);
  }

  .card {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-hairline-soft);
    border-radius: var(--radius-lg);
    padding: var(--space-3);
  }
  .rel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }
  .rel-head h3 {
    font-size: var(--text-lg);
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
  .latest {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-primary-strong);
    background: var(--color-primary-soft);
    padding: 2px 10px;
    border-radius: var(--radius-pill);
  }
  .rel-head time {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  .changes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .changes li {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .tag {
    flex-shrink: 0;
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    line-height: 1.6;
  }
  .k-added {
    color: var(--color-success);
    background: color-mix(in srgb, var(--color-success) 12%, transparent);
  }
  .k-changed {
    color: var(--color-primary-strong);
    background: var(--color-primary-soft);
  }
  .k-fixed {
    color: var(--color-warning);
    background: color-mix(in srgb, var(--color-warning) 14%, transparent);
  }
  .changes .text {
    color: var(--color-text-secondary);
  }

  .cta-center {
    margin-top: var(--space-4);
    text-align: center;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-base);
    font-weight: 600;
    padding: 12px 24px;
    border-radius: var(--radius-md);
    min-height: 44px;
  }
  .btn-outline {
    border: 1px solid var(--color-hairline);
    color: var(--color-text);
    background: var(--color-surface-raised);
  }
  .btn-outline:hover {
    border-color: var(--color-primary);
    color: var(--color-primary-strong);
    text-decoration: none;
  }

  /* Scroll reveal — same keyframe approach as Screenshots (a transition
     would be skipped when the section is already in view on load). */
  @keyframes wn-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  :global(html.js) .reveal:not(.in) {
    opacity: 0;
  }
  :global(html.js) .reveal.in {
    animation: wn-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms) both;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .reveal:not(.in) {
      opacity: 1;
    }
    :global(html.js) .reveal.in {
      animation: none;
    }
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>('#whatsnew .reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
    );
    items.forEach((el) => io.observe(el));
  } else {
    items.forEach((el) => el.classList.add('in'));
  }
</script>
