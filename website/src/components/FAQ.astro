---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const faqs = [1, 2, 3, 4, 5].map((n) => ({
  q: t(`faq.q${n}` as never),
  a: t(`faq.a${n}` as never),
}));

// FAQPage structured data — eligible for rich results in search.
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section id="faq" class="section faq-section">
  <div class="container narrow">
    <div class="section-head">
      <p class="eyebrow">FAQ</p>
      <h2>{t('faq.title')}</h2>
    </div>
    <div class="list">
      {
        faqs.map((f) => (
          <details class="item">
            <summary>
              <span>{f.q}</span>
              <svg class="chev" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</section>

<style>
  .faq-section {
    background: var(--color-surface-sunken);
    border-block: 1px solid var(--color-hairline-soft);
  }
  .narrow {
    max-width: 760px;
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .item {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-hairline-soft);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
    font-weight: 600;
    font-size: var(--text-base);
    list-style: none;
    min-height: 44px;
  }
  .item summary::-webkit-details-marker {
    display: none;
  }
  .item summary:hover {
    color: var(--color-primary-strong);
  }
  .chev {
    flex-shrink: 0;
    color: var(--color-text-tertiary);
    transition: transform 0.2s ease;
  }
  .item[open] .chev {
    transform: rotate(180deg);
  }
  .item p {
    padding: 0 var(--space-3) var(--space-2);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.7;
  }
</style>
